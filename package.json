{
  "name": "@quantile-co/github",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.9.0",
  "scripts": {
    "prepare": "husky",
    "build": "TURBO_CACHE=\"${TURBO_CACHE:-local:rw}\" turbo run build",
    "skills:sync": "skills experimental_sync --agent pi --copy --yes --include @quantile-co/factory-pi#deploy @quantile-co/factory-pi#day-zero-deploy @quantile-co/factory-pi#terraform-style-guide",
    "check": "pnpm run build && TURBO_CACHE=\"${TURBO_CACHE:-local:rw}\" turbo run check",
    "fix": "pnpm --filter @quantile-co/github-repo-cli fix",
    "test": "pnpm run check && TURBO_CACHE=\"${TURBO_CACHE:-local:rw}\" turbo run test",
    "github:plan": "tsx apps/github/cli.ts plan",
    "github:apply": "tsx apps/github/cli.ts apply"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.2",
    "@quantile-co/factory-pi": "0.1.0",
    "@types/node": "26.6.5",
    "husky": "9.1.7",
    "skills": "1.7.4",
    "tsx": "4.23.15",
    "turbo": "2.11.10",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  }
}
