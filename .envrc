#!/usr/bin/env bash
# shellcheck shell=bash
source_env_if_exists .envrc.local
eval "$(devenv direnvrc)"
use devenv

# Keep Pi's memory in this worktree after loading the development environment.
PI_MEMORY_DIR="$(git rev-parse --show-toplevel)/.pi/memory"
export PI_MEMORY_DIR
# Avoid automatic conversation summaries in this checkout's local memory.
export PI_MEMORY_EXIT_SUMMARY=0
