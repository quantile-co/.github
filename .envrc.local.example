# Optional inputs for an authorized local plan against this repository's
# existing remote state. .envrc.local is ignored; never commit real values.
# Authenticate to Google Cloud and obtain GitHub credentials from the
# approved secure source. Do not run the historical Day 0 bootstrap.
#
# export TF_VAR_gcp_billing_account=...
# export TF_VAR_gcp_folder_id=...
# export TF_VAR_gcp_wif_pool=...
# export TF_VAR_gh_maintainers='["your-github-username"]'
# export GITHUB_TOKEN=...   # Repository-scoped token from a secure source.
# export REST_API_BEARER=... # Same token as GITHUB_TOKEN.
# export TF_STATE_BUCKET=... # Existing .github state bucket.
#
# Protected Plan/Apply use prefix repository/prod. `check:tf` isolates its
# credential-free initialization from the production backend.
